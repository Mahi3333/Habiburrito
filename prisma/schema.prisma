// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MenuItem {
  id          Int                @id @default(autoincrement())
  key         String             @unique
  name        String
  description String?
  price       Float
  category    String             // legacy category slug
  category_id Int?
  category_ref MenuCategory?     @relation(fields: [category_id], references: [id])
  image_url   String?
  chef_note   String?
  is_signature Boolean           @default(false)
  is_available Boolean           @default(true)
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  modifier_groups MenuItemModifierGroup[]
  included_items MenuItemIncludedOption[]
}

enum ModifierGroupType {
  SELECT
  FREE_TEXT
}

model MenuCategory {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  name       String
  aliases    String[] @default([])
  is_active  Boolean  @default(true)
  sort_order Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  items      MenuItem[]
}

model Modifier {
  id            Int                @id @default(autoincrement())
  key           String             @unique
  name          String
  max_selection Int
  type          ModifierGroupType  @default(SELECT)
  is_active     Boolean            @default(true)
  options       ModifierOption[]

  item_links    MenuItemModifierGroup[]
}

model ModifierOption {
  id               Int      @id @default(autoincrement())
  key              String   @unique
  modifier_id      Int
  modifier         Modifier @relation(fields: [modifier_id], references: [id])
  name             String
  price_adjustment Float    @default(0.00)
  is_active        Boolean  @default(true)
  included_in      MenuItemIncludedOption[]
  defaults_in      MenuItemModifierDefault[]
}



model MenuItemModifierGroup {
  id                Int      @id @default(autoincrement())
  menu_item_id      Int
  modifier_id       Int
  title_override    String?
  required          Boolean  @default(false)
  min_select        Int      @default(0)
  max_select        Int      @default(0)
  allow_quantity    Boolean  @default(false)
  allow_none_option Boolean  @default(false)
  notes             String?
  free_text_max_length Int?

  menu_item MenuItem @relation(fields: [menu_item_id], references: [id])
  modifier  Modifier @relation(fields: [modifier_id], references: [id])
  defaults  MenuItemModifierDefault[]

  @@unique([menu_item_id, modifier_id])
}

model MenuItemModifierDefault {
  id            Int  @id @default(autoincrement())
  item_group_id Int
  option_id     Int
  quantity      Int  @default(1)

  item_group MenuItemModifierGroup @relation(fields: [item_group_id], references: [id])
  option     ModifierOption        @relation(fields: [option_id], references: [id])

  @@unique([item_group_id, option_id])
}

model MenuItemIncludedOption {
  id          Int  @id @default(autoincrement())
  menu_item_id Int
  option_id   Int
  quantity    Int  @default(1)

  menu_item MenuItem      @relation(fields: [menu_item_id], references: [id])
  option    ModifierOption @relation(fields: [option_id], references: [id])

  @@unique([menu_item_id, option_id])
}

model AppSetting {
  id                       Int      @id @default(autoincrement())
  online_ordering_enabled  Boolean  @default(true)
  override_message         String?
  updated_at               DateTime @updatedAt

  @@unique([id])
}

model StoreHour {
  id         Int     @id @default(autoincrement())
  day        String  // e.g. Sunday, Monday
  open_time  String  // HH:mm 24h
  close_time String  // HH:mm 24h
  closed     Boolean @default(false)

  @@unique([day])
}

model StoreHoliday {
  id         Int      @id @default(autoincrement())
  date       String   @unique // YYYY-MM-DD in store local time
  name       String?
  message    String?
  closed     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Order {
  id                       Int         @id @default(autoincrement())
  user_id                  Int?        // Optional FK to User
  user                     User?       @relation(fields: [user_id], references: [id])
  total_amount             Float
  tax_amount               Float
  status                   String      @default("PENDING_PAYMENT")
  stripe_payment_intent_id String      @unique
  created_at               DateTime    @default(now())
  items                    OrderItem[]
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  order_id     Int
  order        Order  @relation(fields: [order_id], references: [id])
  item_name    String
  quantity     Int
  json_details String // Stores full JSON structure of the item
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?
  phone         String   @unique
  email         String?
  username      String?
  password_hash String?
  role          String   @default("CUSTOMER") // 'ADMIN', 'CUSTOMER'
  rewards_points Int     @default(0)
  orders        Order[]
  created_at    DateTime @default(now())
}
